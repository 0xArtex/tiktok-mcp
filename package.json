{
  "name": "@palmyr/tiktok-mcp",
  "version": "0.2.0",
  "description": "Post, schedule, manage, and analyze TikTok accounts from any MCP-compatible AI agent.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tiktok-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/tests",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tiktok",
    "tiktok-automation",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "social-media-automation",
    "x402"
  ],
  "author": "Palmyr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xArtex/tiktok-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/0xArtex/tiktok-mcp/issues"
  },
  "homepage": "https://github.com/0xArtex/tiktok-mcp#readme",
  "mcpName": "ai.palmyr/tiktok",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
